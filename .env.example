# ===== App =====
APP_ENV=development          # development | production
APP_PORT=8000
LOG_LEVEL=INFO               # DEBUG | INFO | WARNING | ERROR

# ===== Twilio =====
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=          # Your Twilio number
YOUR_PERSONAL_NUMBER=        # Your real number for call transfer

# ===== Deepgram =====
DEEPGRAM_API_KEY=
DEEPGRAM_STT_MODEL=nova-3     # multilingual (Hindi/English/Hinglish)
DEEPGRAM_TTS_MODEL=aura-asteria-en   # or aura-hera-en

# ===== Groq =====
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-70b-versatile

# ===== Supabase =====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=    # backend service-role key (server only)

# ===== Server =====
SERVER_BASE_URL=              # public URL for Twilio webhooks, e.g. ngrok URL

# ===== CORS =====
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5174,http://localhost:5173
